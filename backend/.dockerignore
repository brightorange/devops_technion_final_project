# Keep the build context small and the image free of dev/secret files.
# Patterns match only at the top level unless prefixed with **/
.venv
**/__pycache__
**/*.pyc
**/.env
.pytest_cache
.coverage
coverage.xml
htmlcov
Dockerfile
.dockerignore

# tests/, requirements-dev.txt and setup.cfg stay in the context: the `test`
# build target needs them. They never reach the runtime image, which copies
# only app/, migrations/ and wsgi.py.
